APP_NAME=CyberSage
APP_ENV=development
DEBUG=false

# Credentials may also live in the repository-root .env used by Compose.
# Environment variables override both files; backend/.env overrides root .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Set these to match Docker Compose. Never commit your actual .env.
POSTGRES_USER=cybersage
POSTGRES_PASSWORD=
POSTGRES_DB=cybersage

# Permissive cosine similarity cutoff; not a probability of correctness.
RETRIEVAL_MIN_SIMILARITY=0.2
