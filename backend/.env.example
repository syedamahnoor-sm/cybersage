APP_NAME=CyberSage
APP_ENV=development
DEBUG=false

# Credentials may also live in the repository-root .env used by Compose.
# Environment variables override both files; backend/.env overrides root .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Set these to match Docker Compose. Never commit your actual .env.
POSTGRES_USER=cybersage
POSTGRES_PASSWORD=
POSTGRES_DB=cybersage

# Permissive cosine similarity cutoff; not a probability of correctness.
RETRIEVAL_MIN_SIMILARITY=0.2

# Optional for RAG only. Never commit an actual API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=2048
RAG_MAX_RETRIEVED_CHUNKS=8
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_PROMPT_CHARS=24000
MEMORY_HISTORY_TURNS=6
MEMORY_HISTORY_CHARS=8000
