# Server-side Next.js rewrite target; restart Next.js after changing.
FASTAPI_BASE_URL=http://127.0.0.1:8000
# Optional direct-browser API base. Leave unset for same-origin rewrites (no CORS needed).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Never put provider keys, database credentials, or secrets in NEXT_PUBLIC_* variables.
